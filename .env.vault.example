# Copy this file to .env.vault (gitignored), fill in real values.
# This is your single source of truth — paste from here into both:
#   1) Cloudflare Worker secrets via `wrangler secret put <NAME>`
#   2) GitHub Repository Secrets at Settings → Secrets and variables → Actions

# === Worker secrets (set via wrangler secret put) ===
FB_APP_SECRET=
FB_VERIFY_TOKEN=        # any random string you choose, must match FB webhook config
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === GitHub Secrets only (used by GH Actions, NOT needed in Worker) ===
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=         # ea2ab248-c877-4f2b-91ac-932e2a52f781

# === Reference (not a secret) ===
WORKER_URL=             # filled in after `npm run deploy`
